# ---------------------------------------------------------------------------
# Frontend (Vite) — only these are exposed to the browser. NEVER put an API key
# in a VITE_* variable: anything prefixed VITE_ is bundled into the client.
# ---------------------------------------------------------------------------
# Set to "live" to route the assistant through your backend proxy.
VITE_AI_MODE=demo
# Where the proxy lives (default shown). Use an absolute URL in development.
VITE_AI_ENDPOINT=http://localhost:8787/api/assistant
# Label only — displayed in the assistant header in live mode.
VITE_AI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Backend proxy (server/index.js) — read with process.env, never bundled.
# ---------------------------------------------------------------------------
PORT=8787
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Restrict to your frontend origin in production, e.g. https://skillbridge.in
ALLOW_ORIGIN=*
